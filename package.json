{
  "name": "@mux/alchemy",
  "version": "0.1.0",
  "private": true,
  "description": "Mux resources and runtime bindings for Alchemy v2: assets, live streams, Robots, webhooks, signing keys and more.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muxinc/alchemy-mux.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "deploy": "alchemy deploy example/alchemy.run.ts",
    "destroy": "alchemy destroy example/alchemy.run.ts",
    "generate": "bun scripts/generate.ts",
    "verify": "bun test/verify.ts"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.87",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/platform-bun": "^4.1.4",
    "@effect/platform-node": "^4.1.4",
    "@mux/ts": "16.2.0",
    "@types/bun": "^1.4.4",
    "alchemy": "2.0.0-beta.87",
    "effect": "^4.1.4",
    "openapi-typescript": "7",
    "typescript": "5.9"
  }
}
